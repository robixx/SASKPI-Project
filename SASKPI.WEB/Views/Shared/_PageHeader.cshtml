@model Tuple<string,string,object>
@{
    var title = Model?.Item1 ?? ViewData["Title"]?.ToString() ?? "";
    var subtitle = Model?.Item2 ?? ViewData["Subtitle"]?.ToString() ?? "";
    var actions = Model?.Item3; // optional html or null
}
<div class="d-flex justify-content-between align-items-center mb-3 page-header">
    <div>
        <h4 class="mb-0 text-dark" style="color:var(--text-main)">@title</h4>
        @if(!string.IsNullOrEmpty(subtitle)) { <small class="text-muted">@subtitle</small> }
    </div>
    <div class="header-actions">
        @if (actions != null)
        {
            @Html.Raw(actions.ToString())
        }
    </div>
</div>