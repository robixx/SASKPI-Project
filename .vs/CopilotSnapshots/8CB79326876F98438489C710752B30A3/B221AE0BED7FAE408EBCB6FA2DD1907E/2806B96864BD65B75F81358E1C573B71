@{
    ViewData["Title"] = "Project Board";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">NexusFlow — Sprint Board</h4>
            <small class="text-muted">Sprint 23 • Ends in 6 days</small>
        </div>
        <div class="d-flex gap-2">
            <button class="btn btn-outline-secondary">Filters</button>
            <button class="btn btn-primary">Create Issue</button>
        </div>
    </div>

    <div class="kanban-board">
        <div class="kanban-column">
            <h6>Backlog <span class="badge bg-light text-muted ms-1">4</span></h6>
            <div class="issue-card">
                <div class="d-flex justify-content-between align-items-start">
                    <div>
                        <div class="fw-600">[PROJ-101] Improve onboarding flow</div>
                        <div class="meta">Epic: Onboarding • Assignee: J. Doe</div>
                    </div>
                    <div><span class="badge-subtle">High</span></div>
                </div>
            </div>
            <div class="issue-card">
                <div class="fw-600">[PROJ-102] Add phone verification</div>
                <div class="meta">Assignee: M. Vance</div>
            </div>
        </div>

        <div class="kanban-column">
            <h6>To Do <span class="badge bg-light text-muted ms-1">2</span></h6>
            <div class="issue-card">
                <div class="fw-600">[PROJ-110] Audit log export</div>
                <div class="meta">Assignee: S. Jenkins • 3 subtasks</div>
            </div>
            <div class="issue-card">
                <div class="fw-600">[PROJ-117] Support multi-tenant themes</div>
                <div class="meta">Assignee: A. Rivera</div>
            </div>
        </div>

        <div class="kanban-column">
            <h6>In Progress <span class="badge bg-light text-muted ms-1">3</span></h6>
            <div class="issue-card">
                <div class="fw-600">[PROJ-121] API Gateway rate-limits</div>
                <div class="meta">Assignee: Dev Team • Progress: 65%</div>
            </div>
            <div class="issue-card">
                <div class="fw-600">[PROJ-125] Billing reconciliation job</div>
                <div class="meta">Assignee: Ops • ETA: Today</div>
            </div>
        </div>

        <div class="kanban-column">
            <h6>Done <span class="badge bg-light text-muted ms-1">5</span></h6>
            <div class="issue-card">
                <div class="fw-600">[PROJ-091] Fix login CSRF</div>
                <div class="meta">Merged • Deployed</div>
            </div>
        </div>
    </div>
</div>
