@{
    ViewData["Title"] = "Project Settings";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-3">
        <div>
            <h4 class="mb-0">Project Settings</h4>
            <small class="text-muted">Manage integrations, permissions and feature flags</small>
        </div>
        <div>
            <button class="btn btn-outline-secondary btn-sm">Reset</button>
            <button class="btn btn-primary btn-sm">Save</button>
        </div>
    </div>

    <div class="row g-3">
        <div class="col-12 col-md-6">
            <div class="premium-panel p-3">
                <h6>Feature Flags</h6>
                <div class="form-check form-switch my-2">
                    <input class="form-check-input" type="checkbox" id="ff1" checked>
                    <label class="form-check-label" for="ff1">Enable Advanced Analytics</label>
                </div>
                <div class="form-check form-switch my-2">
                    <input class="form-check-input" type="checkbox" id="ff2">
                    <label class="form-check-label" for="ff2">Enable Multi-tenancy</label>
                </div>
            </div>
        </div>

        <div class="col-12 col-md-6">
            <div class="premium-panel p-3">
                <h6>Integrations</h6>
                <div class="mb-2">Jira: <strong class="text-success">Connected</strong></div>
                <div class="mb-2">Slack: <strong class="text-muted">Not Connected</strong> <button class="btn btn-sm btn-outline-secondary ms-2">Connect</button></div>
            </div>
        </div>
    </div>
</div>
